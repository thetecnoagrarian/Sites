<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - Admin Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css?v=20251101-1320">
    <link rel="stylesheet" href="/css/admin.css?v=20251101-1320">
    <!-- Shoelace components -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/themes/light.css" />
    <script type="module" src="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/shoelace.js"></script>
    <script type="module">
        import { setBasePath } from 'https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/shoelace.js';
        setBasePath('https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/');
    </script>
    <style>
        /* Override Shoelace primary button colors using CSS custom properties */
        /* This approach uses CSS custom properties to override Shoelace's default colors */
        :root {
            --sl-color-primary-600: var(--primary);
            --sl-color-primary-500: var(--primary);
            --sl-color-primary-400: var(--primary-dark);
        }
        
        /* Admin primary button overrides using class-based approach */
        .admin-primary-button::part(base) {
            --sl-color-primary-600: var(--primary);
            --sl-color-primary-500: var(--primary);
            --sl-color-primary-400: var(--primary-dark);
        }
        
        .admin-primary-button::part(base):hover {
            --sl-color-primary-600: var(--primary-dark);
            --sl-color-primary-500: var(--primary-dark);
            --sl-color-primary-400: var(--primary-dark);
        }
    </style>
</head>
<body>
    <header>
        <div class="site-header">
            <div class="site-logo">
                <a href="/admin"><img src="/images/TTA.PNG" alt="The Tecnoagrarian Logo" class="logo-image"></a>
            </div>
            <button class="hamburger">
                <i class="fas fa-bars"></i>
            </button>
            <nav>
                <ul>
                    <li><a href="/admin/analytics">Analytics</a></li>
                    <li><a href="/admin/categories">Categories</a></li>
                    <li><a href="/" target="_blank">View Site</a></li>
                    {{#if user.isAdmin}}
                    <li><a href="/admin/posts/new">New Post</a></li>
                    {{/if}}
                    <li>
                        <form action="/logout" method="POST" style="display: inline;">
                            <input type="hidden" name="_csrf" value="{{csrfToken}}">
                            <button type="submit" class="logout">Logout</button>
                        </form>
                    </li>
                </ul>
            </nav>
        </div>
    </header>

    <div class="menu-overlay hidden"></div>

    <main>
        {{{body}}}
    </main>

    <script src="/js/admin.js"></script>
</body>
</html> 