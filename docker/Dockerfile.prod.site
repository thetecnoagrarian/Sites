# Multi-stage production Dockerfile for blog sites
# Stage 1: Build dependencies and prepare application
FROM node:24.19.0-alpine3.23@sha256:244cc2b53f46f9e876304391d17682b0ddae9ac33491f4857e25e35a36ba7995 AS builder

# Build arguments
ARG SITE_DIR_NAME
ARG SITE_PORT

# Install build dependencies (will be removed in final stage)
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    && rm -rf /var/cache/apk/*

# Install a Node 24-compatible npm version deterministically
RUN npm install -g npm@11.19.0

# Set working directory
WORKDIR /app

# Copy root package files first (better Docker layer caching)
COPY package.json package-lock.json* ./

# Copy package files for workspaces
COPY blog-core/package.json ./blog-core/
COPY ${SITE_DIR_NAME}/package.json ./${SITE_DIR_NAME}/

# Install production dependencies, including Sharp's platform-specific optional packages
RUN npm ci --omit=dev --include=optional && npm cache clean --force

# Copy source code (only what's needed for production)
COPY blog-core/src ./blog-core/src
COPY blog-core/src/index.js ./blog-core/src/index.js
COPY ${SITE_DIR_NAME}/src ./${SITE_DIR_NAME}/src

# Stage 2: Production image (minimal size)
FROM node:24.19.0-alpine3.23@sha256:244cc2b53f46f9e876304391d17682b0ddae9ac33491f4857e25e35a36ba7995

# Build arguments (needed for runtime)
ARG SITE_DIR_NAME
ARG SITE_PORT

# Install only runtime dependencies (no build tools)
RUN apk add --no-cache \
    sqlite \
    bash \
    curl \
    vips \
    libc6-compat \
    && rm -rf /var/cache/apk/*

# Set working directory
WORKDIR /app

# Copy root package.json for workspace resolution
COPY --from=builder /app/package.json ./package.json
# Copy package-lock.json if it exists (optional)
COPY --from=builder /app/package-lock.json* ./

# Copy installed node_modules from builder (workspace hoists dependencies to root)
COPY --from=builder /app/node_modules ./node_modules

# Copy application code from builder stage
COPY --from=builder /app/blog-core ./blog-core
COPY --from=builder /app/${SITE_DIR_NAME} ./${SITE_DIR_NAME}

# Create necessary directories
RUN mkdir -p /app/data/database /app/data/uploads /app/logs /app/backups /app/scripts

# Copy scripts
COPY scripts/backup.sh /app/scripts/backup.sh
COPY scripts/cleanup-analytics-container.js /app/scripts/cleanup-analytics-container.js

# Set proper permissions
RUN addgroup -g 1001 -S blog && \
    adduser -S blog -u 1001 -G blog && \
    chown -R blog:blog /app/data /app/logs /app/backups /app/scripts /app/${SITE_DIR_NAME} /app/blog-core && \
    chmod +x /app/scripts/backup.sh /app/scripts/cleanup-analytics-container.js

# Switch to non-root user
USER blog

# Set working directory to the specific site
WORKDIR /app/${SITE_DIR_NAME}

# Expose port
EXPOSE ${SITE_PORT}

# Set environment
ENV NODE_ENV=production
ENV PORT=${SITE_PORT}

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${SITE_PORT}/health || exit 1

# Start the application
CMD ["node", "src/app.js"]
